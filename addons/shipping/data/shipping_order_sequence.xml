<odoo>
    <record id="seq_shipping_order" model="ir.sequence">
        <field name="name">Orden Envío USA → Cuba</field>
        <field name="code">shipping.order</field>

        <!-- Prefijo dinámico -->
        <field name="prefix">OEUC-%(y)s-%(month)s-%(day)s-</field>

        <!-- Contador -->
        <field name="padding">4</field>

        <!-- Multi-compañía -->
        <field name="company_id" eval="False"/>
    </record>
</odoo>
