<odoo>
    <record id="view_partner_form_vip" model="ir.ui.view">
    <field name="name">partner.form.vip</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='email']" position="after">
            <field name="is_vip"/>
            <field name="membership_level"/>
            <field name="points" />
            <field name="discount_percentage"/>
        </xpath>
    </field>
   </record>

    <record id="action_vip_clients" model="ir.actions.act_window">
        <field name="name">Clientes VIP</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_vip', '=', True)]</field>
    </record>
</odoo>