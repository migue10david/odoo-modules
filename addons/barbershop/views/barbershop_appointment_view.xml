<odoo>
    <record id="barbershop_appointment_view_list" model="ir.ui.view">
        <field name="name">barbershop.appointment.list</field>
        <field name="model">barbershop.appointment</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'" decoration-success="state == 'done'" decoration-warning="state == 'confirmed'" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="client_id"/>
                <field name="barber_id"/>
                <field name="service_id"/>
                <field name="date"/>
                <field name="price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'done'" decoration-warning="state == 'confirmed'" decoration-muted="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="barbershop_appointment_view_kanban" model="ir.ui.view">
        <field name="name">barbershop.appointment.kanban</field>
        <field name="model">barbershop.appointment</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="client_id"/>
                <field name="barber_id"/>
                <field name="service_id"/>
                <field name="date"/>
                <field name="price"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="oe_partner_heading"><t t-esc="record.name.value"/></strong>
                                <ul>
                                    <li><strong>Cliente: </strong><field name="client_id"/></li>
                                    <li><strong>Barbero: </strong><field name="barber_id"/></li>
                                    <li><strong>Servicio: </strong><field name="service_id"/></li>
                                    <li><strong>Fecha: </strong><field name="date"/></li>
                                    <li>
                                        <strong>Precio: </strong>
                                        <field name="price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    </li>
                                    <li><strong>Estado: </strong><field name="state" widget="label_selection" options="{'classes': {'draft': 'info', 'confirmed': 'warning', 'done': 'success', 'cancel': 'default'}}"/></li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="barbershop_appointment_view_form" model="ir.ui.view">
        <field name="name">barbershop.appointment.form</field>
        <field name="model">barbershop.appointment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirmar" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_done" string="Finalizar" type="object" class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_draft" string="Volver a Borrador" type="object" invisible="state not in ['confirmed', 'cancel']"/>
                    <button name="action_cancel" string="Cancelar" type="object" invisible="state not in ['draft', 'confirmed']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre de la cita"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="client_id" options="{'no_create': True}"/>
                            <field name="barber_id" options="{'no_create': True}"/>
                            <field name="service_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="barbershop_appointment_menu_action" model="ir.actions.act_window">
        <field name="name">Citas</field>
        <field name="res_model">barbershop.appointment</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="barbershop_appointment_view_search" model="ir.ui.view">
        <field name="name">barbershop.appointment.search</field>
        <field name="model">barbershop.appointment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="client_id"/>
                <field name="barber_id"/>
                <field name="date"/>
                <filter string="Hoy" name="today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Borrador" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmadas" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Realizadas" name="done" domain="[('state', '=', 'done')]"/>
                <group expand="0" string="Group By">
                    <filter string="Fecha" name="date" context="{'group_by': 'date'}"/>
                    <filter string="Barbero" name="barber_id" context="{'group_by': 'barber_id'}"/>
                    <filter string="Estado" name="state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
