<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="barbershop_client_view_list" model="ir.ui.view">
        <field name="name">barbershop.client.list</field>
        <field name="model">barbershop.client</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="email" widget="email"/>
                <field name="phone" widget="phone"/>
            </list>
        </field>
    </record>

    <record id="barbershop_client_view_kanban" model="ir.ui.view">
        <field name="name">barbershop.client.kanban</field>
        <field name="model">barbershop.client</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="color"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_color_#{kanban_getcolor(record.color.raw_value)} oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <t t-if="record.email.raw_value">
                                    <img alt="" t-att-src="kanban_image('barbershop.client', 'image_128', record.id)" style="width: 50px; height: 50px; border-radius: 50%;"/>
                                </t>
                                <t t-else="">
                                    <div class="o_kanban_avatar_placeholder" style="width: 50px; height: 50px; border-radius: 50%; background-color: #875A7B; color: white; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                                        <t t-esc="record.name.raw_value ? record.name.raw_value[0] : '?'"/>
                                    </div>
                                </t>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="oe_partner_heading"><t t-esc="record.name.value"/></strong>
                                <ul>
                                    <li><field name="email" widget="email"/></li>
                                    <li><field name="phone" widget="phone"/></li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="barbershop_client_view_form" model="ir.ui.view">
        <field name="name">barbershop.client.form</field>
        <field name="model">barbershop.client</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre del cliente"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                        </group>
                        <group>
                            <field name="create_date" readonly="1"/>
                            <field name="color" widget="color_palette"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Citas" name="appointments">
                            <field name="appointements_ids"/>
                        </page>
                        <page string="Notas">
                            <field name="note" placeholder="Notas adicionales..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="barbershop_client_menu_action" model="ir.actions.act_window">
        <field name="name">Clientes</field>
        <field name="res_model">barbershop.client</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="barbershop_client_view_search" model="ir.ui.view">
        <field name="name">barbershop.client.search</field>
        <field name="model">barbershop.client</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('email', 'ilike', self)]" string="Nombre o Email"/>
                <field name="email"/>
                <field name="phone"/>
                <filter string="Con Email" name="has_email" domain="[('email', '!=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Fecha de Creación" name="create_date" context="{'group_by': 'create_date'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>