<odoo>
    <record id="barbershop_accessory_view_list" model="ir.ui.view">
        <field name="name">barbershop.accessory.list</field>
        <field name="model">barbershop.accessory</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="is_active"/>
            </list>
        </field>
    </record> 

    <record id="barbershop_accessory_view_form" model="ir.ui.view">
        <field name="name">barbershop.accessory.form</field>
        <field name="model">barbershop.accessory</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                    <field name="is_active"/>
                    <field name="barber_id" widget="many2one"/>
                </group>
            </form>
        </field>
    </record>

    <record id="barbershop_accessory_menu_action" model="ir.actions.act_window">
        <field name="name">Accesorios</field>
        <field name="res_model">barbershop.accessory</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>