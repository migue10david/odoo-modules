<odoo>
    <record id="barbershop_barber_view_list" model="ir.ui.view">
        <field name="name">barbershop.barber.list</field>
        <field name="model">barbershop.barber</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="phone" widget="phone"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="barbershop_barber_view_kanban" model="ir.ui.view">
        <field name="name">barbershop.barber.kanban</field>
        <field name="model">barbershop.barber</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="phone"/>
                <field name="is_active"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <div class="o_kanban_avatar_placeholder" style="width: 50px; height: 50px; border-radius: 50%; background-color: #007096; color: white; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                                    <t t-esc="record.name.raw_value ? record.name.raw_value[0] : '?'"/>
                                </div>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="oe_partner_heading"><t t-esc="record.name.value"/></strong>
                                <ul>
                                    <li><field name="phone" widget="phone"/></li>
                                    <li>
                                        <span t-if="record.is_active.raw_value" class="badge badge-success">Activo</span>
                                        <span t-else="" class="badge badge-secondary">Inactivo</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="barbershop_barber_view_form" model="ir.ui.view">
        <field name="name">barbershop.barber.form</field>
        <field name="model">barbershop.barber</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre del barbero"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="phone" widget="phone"/>
                            <field name="is_active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="create_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Citas" name="appointments">
                            <field name="appointements_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="barbershop_barber_menu_action" model="ir.actions.act_window">
        <field name="name">Barberos</field>
        <field name="res_model">barbershop.barber</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="barbershop_barber_view_search" model="ir.ui.view">
        <field name="name">barbershop.barber.search</field>
        <field name="model">barbershop.barber</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('phone', 'ilike', self)]" string="Nombre o Teléfono"/>
                <field name="phone"/>
                <filter string="Activos" name="active" domain="[('is_active', '=', True)]"/>
                <filter string="Inactivos" name="inactive" domain="[('is_active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Estado" name="is_active" context="{'group_by': 'is_active'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>